<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee" version="6.1">
	<display-name>Frank!Framework API authentication</display-name>
	<servlet>
		<servlet-name>jsp</servlet-name>
		<servlet-class>org.apache.jasper.servlet.JspServlet</servlet-class>
		<init-param><param-name>development</param-name><param-value>false</param-value></init-param>
	</servlet>
	<security-constraint>
		<web-resource-collection>
			<web-resource-name>Tomcat-managed API</web-resource-name>
			<url-pattern>/api/container/*</url-pattern>
		</web-resource-collection>
		<auth-constraint><role-name>HelloReader</role-name></auth-constraint>
	</security-constraint>
	<security-role><role-name>HelloReader</role-name></security-role>
</web-app>
