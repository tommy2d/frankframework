<Configuration name="ListenerModes">
	<Adapter name="public">
		<Receiver name="public-http">
			<ApiListener allowAllParams="false" uriPattern="public" method="GET" produces="JSON"
				authenticationMethod="NONE"/>
		</Receiver>
		<Receiver name="alias-public-http">
			<ApiListener allowAllParams="false" uriPattern="public/hello-world" method="GET" produces="JSON"
				authenticationMethod="NONE"/>
		</Receiver>
		<Pipeline>
			<Exits><Exit name="READY" state="SUCCESS" code="200"/></Exits>
			<EchoPipe name="Reply" getInputFromFixedValue='{"status":"ok"}'>
				<Forward name="success" path="READY"/>
			</EchoPipe>
		</Pipeline>
	</Adapter>
	<Adapter name="bearer">
		<Receiver name="bearer-http">
			<ApiListener allowAllParams="false" uriPattern="bearer" method="GET" produces="JSON"
				authenticationMethod="JWT" requiredIssuer="${auth.issuer}" jwksURL="${auth.jwks}" requiredClaims="sub,exp,aud" roleClaim="aud" authenticationRoles="${auth.audience}"/>
		</Receiver>
		<Pipeline>
			<Exits><Exit name="READY" state="SUCCESS" code="200"/></Exits>
			<EchoPipe name="Reply" getInputFromFixedValue='{"status":"ok"}'>
				<Forward name="success" path="READY"/>
			</EchoPipe>
		</Pipeline>
	</Adapter>
	<Adapter name="header-jwt">
		<Receiver name="header-jwt-http">
			<ApiListener allowAllParams="false" uriPattern="header-jwt" method="GET" produces="JSON"
				jwtHeader="X-Customer-Token" authenticationMethod="JWT" requiredIssuer="${auth.issuer}" jwksURL="${auth.jwks}" requiredClaims="sub,exp,aud" roleClaim="aud" authenticationRoles="${auth.audience}"/>
		</Receiver>
		<Pipeline>
			<Exits><Exit name="READY" state="SUCCESS" code="200"/></Exits>
			<EchoPipe name="Reply" getInputFromFixedValue='{"status":"ok"}'>
				<Forward name="success" path="READY"/>
			</EchoPipe>
		</Pipeline>
	</Adapter>
	<Adapter name="header">
		<Receiver name="header-http">
			<ApiListener allowAllParams="false" uriPattern="header" method="GET" produces="JSON"
				authenticationMethod="HEADER"/>
		</Receiver>
		<Pipeline>
			<Exits><Exit name="READY" state="SUCCESS" code="200"/></Exits>
			<EchoPipe name="Reply" getInputFromFixedValue='{"status":"ok"}'>
				<Forward name="success" path="READY"/>
			</EchoPipe>
		</Pipeline>
	</Adapter>
	<Adapter name="cookie">
		<Receiver name="cookie-http">
			<ApiListener allowAllParams="false" uriPattern="cookie" method="GET" produces="JSON"
				authenticationMethod="COOKIE"/>
		</Receiver>
		<Pipeline>
			<Exits><Exit name="READY" state="SUCCESS" code="200"/></Exits>
			<EchoPipe name="Reply" getInputFromFixedValue='{"status":"ok"}'>
				<Forward name="success" path="READY"/>
			</EchoPipe>
		</Pipeline>
	</Adapter>
	<Adapter name="issue-header">
		<Receiver name="issue-header-http">
			<ApiListener allowAllParams="false" uriPattern="issue/header" method="POST" produces="TEXT"
				authenticationMethod="JWT" requiredIssuer="${auth.issuer}" jwksURL="${auth.jwks}" requiredClaims="sub,exp,aud" roleClaim="aud" authenticationRoles="${auth.audience}"/>
		</Receiver>
		<Pipeline>
			<Exits><Exit name="READY" state="SUCCESS" code="200"/></Exits>
			<ApiPrincipalPipe name="Issue" action="create" authenticationMethod="header">
				<Forward name="success" path="READY"/>
			</ApiPrincipalPipe>
		</Pipeline>
	</Adapter>
	<Adapter name="issue-cookie">
		<Receiver name="issue-cookie-http">
			<ApiListener allowAllParams="false" uriPattern="issue/cookie" method="POST" produces="TEXT"
				authenticationMethod="JWT" requiredIssuer="${auth.issuer}" jwksURL="${auth.jwks}" requiredClaims="sub,exp,aud" roleClaim="aud" authenticationRoles="${auth.audience}"/>
		</Receiver>
		<Pipeline>
			<Exits><Exit name="READY" state="SUCCESS" code="200"/></Exits>
			<ApiPrincipalPipe name="Issue" action="create" authenticationMethod="cookie">
				<Forward name="success" path="READY"/>
			</ApiPrincipalPipe>
		</Pipeline>
	</Adapter>
</Configuration>
