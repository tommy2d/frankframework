<Configuration name="RoleProtected">
	<Adapter name="basic-hello-world">
		<Receiver name="basic-hello-world-http">
			<ApiListener allowAllParams="false" uriPattern="basic/hello-world" method="GET" produces="JSON"
				authenticationMethod="AUTHROLE" authenticationRoles="HelloReader"/>
		</Receiver>
		<Receiver name="alias-basic-hello-world-http">
			<ApiListener allowAllParams="false" uriPattern="secret/hello-world" method="GET" produces="JSON"
				authenticationMethod="AUTHROLE" authenticationRoles="HelloReader"/>
		</Receiver>
		<Pipeline>
			<Exits><Exit name="READY" state="SUCCESS" code="200"/></Exits>
			<EchoPipe name="Reply" getInputFromFixedValue='{"status":"ok"}'>
				<Forward name="success" path="READY"/>
			</EchoPipe>
		</Pipeline>
	</Adapter>
